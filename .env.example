# Copy this file to .env and fill in real values. .env is gitignored.

# From @BotFather on Telegram (message @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat id. The bot ignores every other chat.
# Easiest way to find it: message your new bot once, then check the
# getUpdates response, or use a bot like @userinfobot.
TELEGRAM_ALLOWED_CHAT_ID=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: only needed once the Notion mirror is wired up (build step 7).
# Get an integration token at https://www.notion.so/my-integrations, then
# share the "Life Log" database with that integration from its Notion page.
NOTION_API_KEY=
# The data source ID for the "Life Log" database (already created for you at
# https://app.notion.com/p/aa51bb40358a44dd857f0624fa46b022):
NOTION_DATA_SOURCE_ID=12436a1c-4b19-403e-9c6a-9a2700cc74d5

# IANA timezone used for "today" boundaries and the nightly digest.
TIMEZONE=Europe/Madrid

# 24h local time the nightly digest is sent, e.g. "22:00"
DIGEST_TIME=22:00
