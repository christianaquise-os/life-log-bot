[Unit]
Description=Personal life-log Telegram bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/life-log-bot
ExecStart=/opt/life-log-bot/.venv/bin/python3 /opt/life-log-bot/main.py
Restart=on-failure
RestartSec=5
EnvironmentFile=/opt/life-log-bot/.env

[Install]
WantedBy=multi-user.target
